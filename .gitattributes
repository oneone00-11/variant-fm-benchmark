# Normalize all text to LF in the repo (the dataset was assembled on Windows;
# this removes the CRLF/LF churn so diffs reflect real content changes only).
* text=auto eol=lf

# Treat result/data tables and figures explicitly.
*.tsv text eol=lf
*.csv text eol=lf
*.py  text eol=lf
*.md  text eol=lf
*.png binary
*.gz  binary
*.tbi binary

# External deposits as the archive served them, byte for byte: their manifests pin
# the sha256 of those bytes, and MaveDB serves its score tables with CRLF line ends.
phase1/data/evidence/external/*_raw/** -text
# The same for the archived versions of the training genes' score sets and the IGVF
# copy of the SBDS scores (E16b); a * above does not reach below one folder.
phase1/data/evidence/external/label_versions/*_raw/** -text
phase1/data/evidence/external/igvf_sbds/** -text
# And for the label source audit's sources (E16c): MaveDB's score tables are CRLF too.
phase1/data/evidence/label_audit/*_raw/** -text
